# Meta Model API Key (https://dev.meta.ai/)
MODEL_API_KEY=your_meta_api_key_here

# Meta Model Name (e.g., muse-spark-1.3, muse-spark-1.3-contributor)
MUSE_MODEL_NAME=muse-spark-1.3

# Base URL for Meta Model API
META_API_BASE_URL=https://api.meta.ai/v1

# Server Settings
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Application Environment (development, testing, production)
APP_ENV=development
